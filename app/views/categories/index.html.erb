<h1 class="text-2xl font-bold mb-6">Categories</h1>
<% @categories.each do |category| %>
  <div class="mb-4">
    <h2 class="text-lg font-semibold mb-2">
      <%= category.name %>
    </h2>

    <ul class="list-disc pl-6 space-y-1 text-gray-600">
      <% category.sub_categories.each do |sub_category| %>
        <li>
          <%= sub_category.name %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>